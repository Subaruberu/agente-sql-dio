# --- Banco de dados ---------------------------------------------------------
# Caminho do arquivo SQLite usado pelo agente.
SQL_AGENT_DB=data/empresa.db

# Máximo de linhas devolvidas por consulta e tentativas extras de correção.
SQL_AGENT_MAX_ROWS=100
SQL_AGENT_MAX_RETRIES=2

# --- Provedor de LLM (API compatível com OpenAI) ----------------------------
# Exemplos:
#   OpenAI   -> LLM_MODEL=gpt-4o-mini          LLM_BASE_URL= (vazio)
#   Groq     -> LLM_MODEL=llama-3.3-70b-versatile
#               LLM_BASE_URL=https://api.groq.com/openai/v1
#   Gemini   -> LLM_MODEL=gemini-2.0-flash
#               LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama   -> LLM_MODEL=qwen2.5-coder:7b
#               LLM_BASE_URL=http://localhost:11434/v1
#               LLM_API_KEY=ollama (qualquer valor não vazio)
#   OpenRouter -> LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sua-chave-aqui
LLM_BASE_URL=
LLM_TEMPERATURE=0
