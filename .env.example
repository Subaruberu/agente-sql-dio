# =============================================================================
# PARTE 1 — Provedor de LLM (API compatível com OpenAI)
# =============================================================================
# OpenAI   -> LLM_MODEL=gpt-4o-mini                         LLM_BASE_URL= (vazio)
# Groq     -> LLM_MODEL=llama-3.3-70b-versatile             LLM_BASE_URL=https://api.groq.com/openai/v1
# Gemini   -> LLM_MODEL=gemini-3.8-flash                    LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Ollama   -> LLM_MODEL=qwen2.5-coder:7b                    LLM_BASE_URL=http://localhost:11434/v1
#             (LLM_API_KEY=ollama — qualquer valor não vazio)
# OpenRouter -> LLM_MODEL=meta-llama/llama-3.3-70b-instruct LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sua-chave-aqui
LLM_BASE_URL=
LLM_TEMPERATURE=0

# =============================================================================
# PARTE 2 — Banco de dados
# =============================================================================
# Backend: "sqlite" (local, banco de exemplo) ou "mysql" (banco remoto/DioBank).
SQL_AGENT_BACKEND=sqlite

# --- SQLite ------------------------------------------------------------------
SQL_AGENT_DB=data/empresa.db

# --- MySQL / DioBank ---------------------------------------------------------
# Usado quando SQL_AGENT_BACKEND=mysql.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=diobank

# Alternativa: uma única URL. Tem prioridade sobre as variáveis MYSQL_* acima.
# DATABASE_URL=mysql://usuario:senha@host:3306/diobank

# Caminho do certificado CA, quando o servidor exige TLS (Azure, RDS, Aiven...).
# Deixe vazio para conexões locais/sem TLS.
MYSQL_SSL_CA=

# --- Limites de execução -----------------------------------------------------
SQL_AGENT_MAX_ROWS=100
SQL_AGENT_MAX_RETRIES=2
